[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/journal_panel.gd" id="1_journal"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_paper"]
bg_color = Color(0.94, 0.89, 0.78, 1)
border_width_left = 6
border_width_top = 6
border_width_right = 6
border_width_bottom = 6
border_color = Color(0.48, 0.23, 0.16, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
shadow_color = Color(0, 0, 0, 0.45)
shadow_size = 12

[node name="JournalPanel" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -230.0
offset_top = -250.0
offset_right = 230.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_paper")
script = ExtResource("1_journal")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.23, 0.15, 0.09, 1)
theme_override_font_sizes/font_size = 34
text = "Journal"
horizontal_alignment = 1

[node name="EvidenceHeader" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.48, 0.23, 0.16, 1)
theme_override_font_sizes/font_size = 22
text = "Evidence found"

[node name="EvidenceList" type="VBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="Separator" type="HSeparator" parent="Margin/VBox"]
layout_mode = 2

[node name="GhostHeader" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.48, 0.23, 0.16, 1)
theme_override_font_sizes/font_size = 22
text = "Possible ghosts"

[node name="GhostList" type="VBoxContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="NoMatch" type="Label" parent="Margin/VBox"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.2, 0.15, 1)
theme_override_font_sizes/font_size = 20
text = "No ghost matches this evidence."

[node name="Spacer" type="Control" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="CloseButton" type="Button" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 18
text = "Close  (F / Esc)"
